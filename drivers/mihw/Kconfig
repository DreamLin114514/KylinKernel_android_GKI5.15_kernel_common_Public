#
# Xiaomi MI hardware/power helpers (built-in port)
#

config MI_UNION_POWER
	bool "MI UnionPower core: frame load / jank monitor"
	default y
	help
	  Port of Xiaomi's unionpower frame load and jank monitoring engine.
	  Receives frame queue/vsync events from the compositor via
	  /proc/unionpower/ioctl, tracks per-process frame intervals and flags
	  jank. Exposes /sys/.../unionpower/frame_jank. Requires the
	  SurfaceFlinger/compositor side to report frame events to be useful;
	  without reporting it is inert.

config MIHW
	bool "Xiaomi Mi hardware/software framework"
	default n
	help
	  Xiaomi Mi hardware/software framework. Enables the millet smart
	  frozen control subsystem (port from xaga / Redmi K50 OSS).

config MILLET_CORE
	bool "frozen framework core"
	depends on MIHW
	default y
	help
	  Mi frozen function: millet core. Creates the NETLINK_MILLET channel
	  and /proc/millet entries used to communicate freeze state with a
	  userspace freezer daemon (e.g. perfmgr).

config MILLET_SIG
	bool "frozen framework signal"
	depends on MIHW
	default y
	help
	  Mi frozen function: reports SIGKILL/SIGTERM/SIGABRT/SIGQUIT events
	  of frozen tasks to userspace via the millet channel.

config MILLET_BINDER
	bool "frozen framework binder"
	depends on MIHW
	default y
	help
	  Mi frozen function: reports binder transactions of frozen processes
	  to userspace so the freezer can decide whether to unfreeze.

config MILLET_BINDER_GKI
	bool "frozen framework binder gki"
	depends on MIHW
	default y
	help
	  Mi frozen function: GKI binder vendor-hook glue feeding binder
	  transaction/reply/wait/alloc events to the millet binder module.

config MILLET_PKG
	bool "frozen framework pkg"
	depends on MIHW
	default y
	help
	  Mi frozen function: netfilter based package network-activity
	  reporting (notifies userspace when a frozen app starts TCP traffic).

config MILLET_HS
	bool "frozen framework hs"
	depends on MIHW
	default y
	help
	  Mi frozen function: millet handshake module (userspace <-> kernel
	  ping/pong on the millet netlink channel).

config MILLET_CGROUP
	bool "frozen framework cgroup"
	depends on MIHW
	default y
	help
	  Mi frozen function: restricts freezer cgroup attach to root / uid 1000
	  (system), matching the xaga behavior for app freezing.
